{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcelevenarchitect-runtime",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "arcelevenarchitect-runtime"
    }
  ],
  "routes": [
    {
      "pattern": "arcelevenarchitect.com/*",
      "zone_name": "arcelevenarchitect.com"
    },
    {
      "pattern": "www.arcelevenarchitect.com/*",
      "zone_name": "arcelevenarchitect.com"
    }
  ],
  "vars": {
    "DATABASE_SSL": "false",
    "NEXT_PUBLIC_DATA_HUB_API_URL": "https://storage.amcmep.in/v1",
    "NEXT_PUBLIC_MAIN_WEB_BASE_URL": "https://amcmep.in",
    "NEXT_PUBLIC_SGE_CLOUD_BASE_URL": "https://cloud.sge.amcmep.in",
    "NEXT_PUBLIC_SGE_PLATFORM_PROJECT_KEY": "amcmep",
    "NEXT_PUBLIC_SGE_WEB_APP_APPLICATION_KEY": "amcmep_web",
    "NEXT_PUBLIC_OPERATIONAL_DATABASE_ID": "amcmep",
    "NEXT_PUBLIC_BUSINESS_ID": "6ab5e485-5b76-4ceb-9f3f-bc61f9bd4687",
    "NEXT_PUBLIC_BUSINESS_NAME": "ARC 11 ARCHITECT"
  }
}
